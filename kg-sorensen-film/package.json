{
  "name": "kg-sorensen-film",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KG Sorensen — Ponta Diamantada FG: filme de produto (experiência scroll + 3D e vídeo Remotion).",
  "scripts": {
    "dev": "vite --config experience/vite.config.ts",
    "build": "vite build --config experience/vite.config.ts",
    "preview": "vite preview --config experience/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "studio": "remotion studio video/src/index.ts --no-open",
    "still": "remotion still video/src/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.535",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@types/react": "19.2.18",
    "@types/three": "0.186.0",
    "playwright": "^1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.3"
  }
}
